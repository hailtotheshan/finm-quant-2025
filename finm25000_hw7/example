# Initialize the trading client (for placing orders, managing account)
trading_client = TradingClient(API_KEY, SECRET_KEY, paper=True)  # Set paper=False for live trading

# Initialize the historical data client
data_client = StockHistoricalDataClient(API_KEY, SECRET_KEY)

# Example: Get historical 1-minute bars for AAPL
request_params = StockBarsRequest(
    symbol_or_symbols=["AAPL"],
    timeframe=TimeFrame.Day,
    start="2021-01-01",
    end="2025-01-01"
)

# Fetch bars (this call will automatically page through all results)
bars_response = data_client.get_stock_bars(request_params)

# Convert to a single DataFrame
# The returned df has a MultiIndex: (symbol, timestamp)
raw_df = bars_response.df

# If you only fetched one symbol, you can drop the symbol level:
# This yields a DatetimeIndex and columns: open, high, low, close, volume, etc.
df = raw_df.xs("AAPL", level="symbol").copy()

# Inspect the head
print(df.head())


